# --- Supabase (Project Settings → API) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only — never exposed

# --- Embeddings (document RAG) --------------------------------------------
# No embedding API key needed. Embeddings run FREE on the Supabase Edge Function
# `rag` using the built-in gte-small model (384-dim, no cold-download).
# Shared secret so the server can call the edge `embed` action:
EMBED_SECRET=change-me-to-a-long-random-string
# Optional: override the functions base URL (defaults to <SUPABASE_URL>/functions/v1)
# SUPABASE_FUNCTIONS_URL=https://YOUR-PROJECT.supabase.co/functions/v1

# --- LiteLLM proxy (backend/) ---------------------------------------------
LITELLM_URL=https://your-litellm-host           # e.g. Cloud Run or Render URL
LITELLM_MASTER_KEY=sk-master-...                 # admin key to mint keys / read spend

# --- Stripe (Pro checkout) ------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...

# --- Public site URL (used in oncue:// deep link + Stripe redirects) ------
# Production (Vercel): https://optimus-the-ai-platform-to-bu.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: override Windows exe download URL (defaults to GitHub Releases)
# NEXT_PUBLIC_RELEASES_URL=https://github.com/ihddirmas/onscreen-ai-agent/releases/latest/download/OnCUE.exe
