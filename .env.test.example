# OnCUE E2E test credentials — copy to .env.test (gitignored).
# Use ONLY for automated testing; never production users.

# --- Test account (fixed for reproducible E2E) ---------------------------
ONCUE_TEST_USER_ID=00000000-0000-4000-8000-000000000001
ONCUE_TEST_EMAIL=oncue-e2e-test@example.com
ONCUE_TEST_PASSWORD=OnCUE-E2E-Test-Only-2026!

# --- Hosted desktop config (written by scripts/provision_test_user.py) ---
ONCUE_BACKEND_URL=http://localhost:4000/v1
ONCUE_WEB_URL=http://localhost:3001
ONCUE_RAG_URL=http://localhost:3001/mock/rag
ONCUE_TOKEN=
HOSTED_MODEL=oncue-default

# --- LiteLLM (local E2E stack) -------------------------------------------
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-master-oncue-e2e-test

# --- Supabase (cloud provision mode — fill for real Supabase test user) ---
# When set, scripts/provision_test_user.py creates/resets user in Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
EMBED_SECRET=oncue-e2e-embed-secret

# --- Local Postgres E2E (default when Supabase not configured) -----------
E2E_DATABASE_URL=postgresql://oncue:oncue-e2e-local@localhost/oncue_e2e
E2E_USAGE_API_PORT=3001
