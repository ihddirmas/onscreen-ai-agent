# --- Provider selection ---------------------------------------------------
# groq (free tier, default for dev) | claude | gpt | gemini | hosted (production)
DEFAULT_PROVIDER=groq

# --- BYO-key providers (dev / power users) --------------------------------
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=

# --- Free fallback LLM API keys (for hosted mode / LiteLLM) ---------------
# These are used by the LiteLLM proxy's oncue-default model chain.
# Each has a permanent free tier — no cost to us at moderate usage.
CEREBRAS_API_KEY=          # cloud.cerebras.ai — fast, 1M tokens/day
CLOUDFLARE_API_KEY=        # dash.cloudflare.com — Workers AI, 10K neurons/day
OPENROUTER_API_KEY=        # openrouter.ai — 20+ free models, 50 req/day

# Model overrides (defaults shown)
GROQ_MODEL=qwen/qwen3.6-27b
CLAUDE_MODEL=claude-opus-4-8
GPT_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.5-flash

# --- Hosted mode (end users: no provider keys needed) ---------------------
ONCUE_BACKEND_URL=
ONCUE_TOKEN=
HOSTED_MODEL=oncue-default
# OnCUE website base URL — enables "search my documents" + personalization.
# Usually set automatically by the website's "Open OnCUE app" button.
ONCUE_WEB_URL=
# Supabase edge `rag` function URL — fast direct document search (lowest latency).
# Also set automatically by the "Open OnCUE app" button.
ONCUE_RAG_URL=

# --- Hotkeys (pynput syntax) ----------------------------------------------
CAPTURE_HOTKEY=<ctrl>+<shift>+<space>
# Chat agent without a screenshot (press again to hide)
CHAT_HOTKEY=<ctrl>+<shift>+h
VOICE_HOTKEY=<ctrl>+<shift>+v
# Hold to dictate into any focused text box (browser, WhatsApp, ChatGPT...)
DICTATE_HOTKEY=<ctrl>+<shift>+d
# Hold to record system audio + mic (meetings), then ask the agent about it
MEETING_HOTKEY=<ctrl>+<shift>+m

# --- Guardrails -----------------------------------------------------------
# Folders (under your home dir) the file tools may touch. NEVER the whole disk.
ALLOWED_DIRS=Documents,Downloads,Desktop
# Ask before launch_app / open_file / open_website
CONFIRM_ACTIONS=true
# Allow the agent to open apps/files/browser and search local files.
# Set false (or toggle in the overlay/tray) to make it answer-only.
SYSTEM_TOOLS_ENABLED=true

# --- Speech ----------------------------------------------------------------
# hinglish (Roman, default) | hindi (Devanagari) | english | auto
STT_LANGUAGE=hinglish
# auto (Groq cloud when key set — fastest & best) | groq | local (offline)
STT_BACKEND=auto
# Groq speech model: whisper-large-v3 (most accurate, best for Hindi/Hinglish)
# or whisper-large-v3-turbo (faster, less accurate)
GROQ_STT_MODEL=whisper-large-v3
# local fallback model: base | small (default) | medium
WHISPER_MODEL=small

# --- Privacy ---------------------------------------------------------------
# Hide the overlay from screen sharing / recording (Zoom, Meet, OBS, etc.).
# You still see it; capturers don't. Toggle live in the tray.
CONTENT_PROTECTION=true

# --- Misc -----------------------------------------------------------------
# Which browser opens searches/YouTube: default (system) | chrome | edge |
# firefox | brave | full path to a browser .exe
PREFERRED_BROWSER=default
CLICK_THROUGH=false
