:{$PORT}

encode gzip

# /api/* routes are custom FastAPI webhooks (Stripe + Razorpay) mounted on
# Reflex's private ASGI app — they must reach the backend, not the static
# file server.
@backend_routes path /_event/* /ping /_upload /_upload/* /api/*
handle @backend_routes {
	reverse_proxy localhost:8000
}

root * /srv
route {
	try_files {path} {path}/ /404.html
	file_server
}
